# Copy to .deploy.env (gitignored) and fill in real values, then run ./deploy.sh
DEPLOY_HOST=103.23.199.164
DEPLOY_USER=kuydinas
# Leave DEPLOY_PASSWORD empty to use SSH keys (recommended). Fill only if using password auth.
DEPLOY_PASSWORD=
DEPLOY_PATH=/www/wwwroot/saham.kuydinas.id
DEPLOY_PORT=3200
PM2_NAME=saham
# Secret token to authorize the daily /api/sync cron
SYNC_TOKEN=change-me-to-a-random-string
# Token to unlock personal watchlist/portfolio in the browser
APP_TOKEN=change-me-too

# --- Email notifications (daily recommendation digest) ---
# Token to authorize the /api/notify/daily cron (falls back to SYNC_TOKEN if empty)
NOTIFY_TOKEN=
# SMTP transport. For Gmail: host=smtp.gmail.com, port=465, user=<your-gmail>,
# pass=<App Password> (Google Account → Security → 2FA → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# From header (defaults to SMTP_USER) and recipient of the digest.
MAIL_FROM=
MAIL_TO=bernaldo.stis@gmail.com
