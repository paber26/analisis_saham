# Runtime config for the Docker container (copy to .env, fill in; gitignored).
# Used by docker-compose.yml via env_file.

# Secret token to authorize the daily /api/sync and /api/alerts/run cron
SYNC_TOKEN=change-me-to-a-random-string
# Token to authorize /api/notify/daily (falls back to SYNC_TOKEN if empty)
NOTIFY_TOKEN=
# Login for personal watchlist/portfolio
APP_TOKEN=change-me-too
APP_USERNAME=
APP_PASSWORD=
APP_SESSION_SECRET=

# Optional Postgres (Neon/Vercel). Empty = file store under /data/store.
POSTGRES_URL=
DATABASE_URL=

# Email digest (Gmail: smtp.gmail.com:465 + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
